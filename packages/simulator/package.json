{
  "name": "@gitamesh/simulator",
  "version": "0.1.0",
  "description": "Deterministic, seedable adversarial scenario harness (`gitamesh simulate`) exercising @gitamesh/core's CoordinationEngine against synthetic agents, tasks, and resource contention.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gitamesh-simulate": "./dist/bin/gitamesh-simulate.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/bin/gitamesh-simulate.ts",
    "test": "vitest run --root ../.. packages/simulator"
  },
  "dependencies": {
    "@gitamesh/core": "workspace:*",
    "@gitamesh/protocol": "workspace:*",
    "@gitamesh/storage-sqlite": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
