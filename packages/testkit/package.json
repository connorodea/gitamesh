{
  "name": "@gitamesh/testkit",
  "version": "0.1.0",
  "description": "Shared test helpers for Gitamesh packages (in-memory engine factory, entity builders).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/testkit"
  },
  "dependencies": {
    "@gitamesh/core": "workspace:*",
    "@gitamesh/protocol": "workspace:*",
    "@gitamesh/storage-sqlite": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
