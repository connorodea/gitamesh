{
  "name": "@gitamesh/cli",
  "version": "0.1.0",
  "description": "The `gitamesh` command-line interface: talks to a running Gitamesh daemon (agents, tasks, locks) and to the local git-adapter for repo/worktree status.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gitamesh": "./dist/bin/gitamesh.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin/gitamesh.ts",
    "test": "vitest run --root ../.. packages/cli"
  },
  "dependencies": {
    "@gitamesh/git-adapter": "workspace:*",
    "@gitamesh/protocol": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
