{
  "name": "@gitamesh/storage-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL (node-postgres) implementation of the Gitamesh StorageAdapter interface, for multi-process/multi-daemon production deployments.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/storage-postgres"
  },
  "dependencies": {
    "@gitamesh/core": "workspace:*",
    "@gitamesh/protocol": "workspace:*",
    "pg": "^8.13.1",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
