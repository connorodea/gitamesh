{
  "$ref": "#/definitions/Task",
  "definitions": {
    "Task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "parent_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "queued",
            "claiming",
            "running",
            "blocked",
            "awaiting_approval",
            "completed",
            "failed",
            "cancelled",
            "dead_letter"
          ]
        },
        "priority": {
          "type": "number"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "join_policy": {
          "type": "string",
          "enum": [
            "all",
            "any",
            "quorum"
          ]
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "task_id",
        "workflow_id",
        "repository_id",
        "parent_task_id",
        "title",
        "description",
        "status",
        "priority",
        "required_capabilities",
        "dependencies",
        "join_policy",
        "base_sha",
        "branch",
        "idempotency_key",
        "deadline_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
